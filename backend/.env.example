PROJECT_NAME=ATLAS
VERSION=1.0
API_V1_STR=/api/v1
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./atlas.db
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CLAUDE_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=llama3.1
MAX_HISTORY_MESSAGES=20
MAX_RETRIEVED_MEMORIES=5
SECRET_KEY=secret-key-for-development-only
# Phase 11: optional shared API key. Leave blank to keep the API open
# (pre-Phase-11 behavior, fine for a trusted local network). Set this to
# require the "X-API-Key" header on every route except /health - and
# enter the same value in the Android app's Settings screen.
API_KEY=
