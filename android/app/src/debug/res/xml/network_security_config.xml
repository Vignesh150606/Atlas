<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 8 stabilization fix.

  Root cause of Phase 7's "builds but doesn't run": targetSdk is 34, and
  since API 28 Android blocks cleartext (plain HTTP) traffic by default
  unless a network security config explicitly allows it for that host. The
  app talks to AppModule's BASE_URL (http://10.0.2.2:8000/...) over plain
  HTTP, so *every* Retrofit call - including plain text chat, not just
  Phase 8 automation - was silently failing at runtime with
  "CLEARTEXT communication to 10.0.2.2 not permitted by network security
  policy", despite compiling and installing fine. This is why the mission
  brief is right that Phase 7 was build-verified but not runtime-verified.

  This file lives under src/debug/ (see src/debug/AndroidManifest.xml),
  so it is only merged into debug builds. Release builds get no
  networkSecurityConfig override and keep the platform default of
  blocking cleartext entirely, which is what we want for a real release.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.2.2 is the Android Emulator's alias for the host
             machine's localhost - see AppModule.BASE_URL / BuildConfig.API_BASE_URL. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
